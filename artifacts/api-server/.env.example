# Base de données PostgreSQL (obligatoire)
DATABASE_URL=postgres://user:password@localhost:5432/mugetra

# Authentification (obligatoire en production — sinon une valeur par défaut non sécurisée est utilisée)
JWT_SECRET=change-moi-en-production

# Port du serveur (Replit fournit cette variable automatiquement)
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Email (optionnel — active l'envoi d'email dans le module Communication et les notifications membres)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# SMS (optionnel — active l'envoi réel de SMS dans le module Communication)
SMS_API_KEY=

# WhatsApp Business API (optionnel — active l'envoi réel de WhatsApp dans le module Communication)
WHATSAPP_API_TOKEN=
